{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/stardew-valley-clone/agent-map.schema.json",
  "title": "Agent Map",
  "type": "object",
  "required": ["schema_version", "lanes", "collision_policy"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "type": "integer", "minimum": 1 },
    "lanes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "owned_paths", "avoid_paths", "primary_checks", "coordination_notes"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "owned_paths": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "avoid_paths": { "type": "array", "items": { "type": "string" } },
          "primary_checks": { "type": "array", "items": { "type": "string" } },
          "coordination_notes": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "collision_policy": {
      "type": "object",
      "required": ["before_editing", "if_conflict_detected"],
      "properties": {
        "before_editing": { "type": "array", "items": { "type": "string" } },
        "if_conflict_detected": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
