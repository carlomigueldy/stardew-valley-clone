{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/stardew-valley-clone/feature-list.schema.json",
  "title": "Feature List",
  "type": "object",
  "required": ["schema_version", "project", "status_values", "epics"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "type": "integer", "minimum": 1 },
    "project": {
      "type": "object",
      "required": ["name", "summary", "issue_tracker"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "issue_tracker": { "type": "string", "enum": ["github"] },
        "repository": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "status_values": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "uniqueItems": true
    },
    "epics": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/epic" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "github_issue": {
      "type": "object",
      "required": ["number", "url", "state"],
      "properties": {
        "number": { "type": ["integer", "null"], "minimum": 1 },
        "url": { "type": ["string", "null"] },
        "state": { "type": "string", "enum": ["placeholder", "open", "closed", "transferred"] }
      },
      "additionalProperties": false
    },
    "epic": {
      "type": "object",
      "required": ["id", "title", "status", "labels", "github_issue", "description", "sub_issues"],
      "properties": {
        "id": { "type": "string", "pattern": "^EPIC-[A-Z0-9-]+$" },
        "title": { "type": "string", "minLength": 1 },
        "status": { "type": "string" },
        "labels": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "github_issue": { "$ref": "#/$defs/github_issue" },
        "description": { "type": "string", "minLength": 1 },
        "sub_issues": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sub_issue" }
        }
      },
      "additionalProperties": false
    },
    "sub_issue": {
      "type": "object",
      "required": ["id", "title", "type", "status", "labels", "github_issue", "depends_on", "paths_allowed", "acceptance_criteria"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Z]+-[0-9]{3}$" },
        "title": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "enum": ["feature", "task", "bug", "chore", "spike"] },
        "status": { "type": "string" },
        "labels": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "github_issue": { "$ref": "#/$defs/github_issue" },
        "depends_on": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "paths_allowed": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "acceptance_criteria": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 }
      },
      "additionalProperties": false
    }
  }
}
