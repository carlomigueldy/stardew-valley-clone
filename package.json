{
  "name": "stardew-valley-clone",
  "version": "0.1.0",
  "private": false,
  "description": "A cozy Stardew-Valley-inspired farming RPG vertical slice built with React, Vite, and Phaser 4.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "quality": "npm run lint && npm run test && npm run build && npm run test:e2e",
    "quality:fast": "npm run lint && npm run test && npm run build",
    "check:attribution": "node scripts/check-attribution.mjs",
    "check:features": "node scripts/validate-feature-list.mjs",
    "check:agents": "node scripts/check-agents-map.mjs",
    "prepare": "husky",
    "release-please": "release-please release-pr --config-file release-please-config.json --manifest-file .release-please-manifest.json",
    "generate:assets": "node scripts/generate-assets.mjs",
    "check:owned-paths": "node scripts/verify-owned-paths.mjs",
    "quality:harness": "SKIP_PACKAGE_CHECKS=1 node scripts/quality-gate.mjs",
    "quality:gate": "node scripts/quality-gate.mjs",
    "issue:sync:dry-run": "node scripts/sync-github-issues.mjs --dry-run",
    "issue:sync:write": "node scripts/sync-github-issues.mjs --write",
    "hooks:install": "node scripts/install-husky-hooks.mjs",
    "check:identity": "node scripts/check-git-identity.mjs",
    "check:commit-msg": "node scripts/check-commit-message.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.3",
    "phaser": "^4.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "release-please": "^16.18.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix --no-warn-ignored"
    ],
    "feature_list.json": [
      "node scripts/validate-feature-list.mjs"
    ],
    "agent-harness/agent-map.json": [
      "node scripts/check-agents-map.mjs"
    ]
  }
}
